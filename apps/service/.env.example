DATABASE_URL="postgres://postgres:password@localhost:5432/db?schema=public"

# When true, run one scheduler tick and exit (point a single 5-minute cron, such as Railway, at this command).
# When unset or false, the process stays up and ticks itself every minute.
USE_EXTERNAL_CRON=true

# Spotify Auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=