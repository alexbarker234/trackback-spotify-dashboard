# Android emulator + Spotify OAuth (run once per emulator session):
#   adb reverse tcp:3000 tcp:3000
# Then use 127.0.0.1 (Spotify allows http loopback redirect URIs).
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Required for push notifications (defaults to the linked EAS project if unset).
EXPO_PUBLIC_EAS_PROJECT_ID=5926b3b8-69e6-4f90-8636-ab7f3e3f034e