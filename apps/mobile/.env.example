# Android emulator + Spotify OAuth (run once per emulator session):
#   adb reverse tcp:3000 tcp:3000
# Then use 127.0.0.1 (Spotify allows http loopback redirect URIs).
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Without adb reverse, API-only (OAuth redirect may fail Spotify checks):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Physical device or when Spotify needs a public HTTPS URL, use ngrok:
# EXPO_PUBLIC_API_URL=https://YOUR_SUBDOMAIN.ngrok-free.app

# Production builds use apps/mobile/.env.production (see mobile.md).
# EXPO_PUBLIC_API_URL=https://trackback.lexalot.dev
